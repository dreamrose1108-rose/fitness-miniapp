.reference-page{padding:32rpx 28rpx 60rpx}.eyebrow{font-size:22rpx;color:#2e7d5b;letter-spacing:2rpx}.heading{font-size:40rpx;font-weight:600;line-height:1.5;margin:20rpx 0}.notice{background:#e8f3ed;color:#355947;padding:24rpx;border-radius:14rpx;font-size:25rpx;line-height:1.8}.source{color:#2e7d5b;font-size:24rpx;padding:20rpx 0}.tabs{display:flex;gap:14rpx;margin:24rpx 0}.tabs button{flex:1;width:0;margin:0;font-size:27rpx;padding:16rpx 0;line-height:1.5;background:white}.tabs .active{background:#2e7d5b;color:white}.section{display:flex;justify-content:space-between;gap:16rpx;align-items:center}.section text{font-size:24rpx;color:#646a73;white-space:nowrap}.title{font-size:29rpx;font-weight:600;line-height:1.6}.hint{font-size:23rpx;line-height:1.8;color:#646a73;margin:16rpx 0 24rpx}.fields{display:flex;gap:14rpx;margin:24rpx 0}.fields label{flex:1;min-width:0;font-size:24rpx;color:#646a73}.fields input{height:72rpx;background:#f5f6f8;border-radius:10rpx;padding:14rpx;margin-top:10rpx;color:#1f2329}.actions{display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap}.actions button{margin:0;width:auto;font-size:22rpx;padding:0 12rpx;color:#2e7d5b;background:#e8f3ed}.done{border:2rpx solid #2e7d5b}.btn-primary{width:100%;font-size:28rpx}
