.reference-page{padding:32rpx 28rpx 60rpx}.eyebrow{font-size:22rpx;color:var(--color-primary);letter-spacing:2rpx}.heading{font-size:40rpx;font-weight:600;line-height:1.5;margin:20rpx 0}.notice{background:var(--color-primary-light);color:var(--color-text);padding:24rpx;border-radius:14rpx;font-size:25rpx;line-height:1.8}.source{color:var(--color-primary);font-size:24rpx;padding:20rpx 0}.tabs{display:flex;gap:14rpx;margin:24rpx 0}.tabs button{flex:1;width:0;margin:0;font-size:27rpx;padding:16rpx 0;line-height:1.5;background:var(--color-card)}.tabs .active{background:var(--color-primary);color:white}.section{display:flex;justify-content:space-between;gap:16rpx;align-items:center}.section text{font-size:24rpx;color:var(--color-text-2);white-space:nowrap}.title{font-size:29rpx;font-weight:600;line-height:1.6}.hint{font-size:23rpx;line-height:1.8;color:var(--color-text-2);margin:16rpx 0 24rpx}.fields{display:flex;gap:14rpx;margin:24rpx 0}.fields label{flex:1;min-width:0;font-size:24rpx;color:var(--color-text-2)}.fields input{height:72rpx;line-height:72rpx;min-width:0;background:var(--color-bg);border-radius:10rpx;padding:0 14rpx;margin-top:10rpx;color:var(--color-text)}.actions{display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap}.actions button{margin:0;width:auto;font-size:22rpx;padding:0 12rpx;color:var(--color-primary);background:var(--color-primary-light)}.done{border:2rpx solid var(--color-primary)}.btn-primary{width:100%;font-size:28rpx}

.tabs button{min-width:0;display:flex;align-items:center;justify-content:center;white-space:normal;}.actions button{max-width:100%;line-height:1.5;padding:12rpx;white-space:normal;}.actions{align-items:stretch;}

.personal-save{background:var(--color-primary-light);padding:24rpx;border-radius:20rpx;margin:24rpx 0;}.personal-save button{margin:12rpx 0;}.personal-save .hint{margin-bottom:0;}
