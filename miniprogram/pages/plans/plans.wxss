.plans-page{padding:24rpx 24rpx 48rpx}.eyebrow{font-size:20rpx;letter-spacing:3rpx;color:var(--color-primary);font-weight:600;margin:8rpx 0 12rpx}.heading{font-size:38rpx;font-weight:650;line-height:1.35}.steps{display:flex;gap:10rpx;align-items:center;font-size:21rpx;color:var(--color-text-3);margin:18rpx 0 20rpx}.steps .current{color:var(--color-primary);font-weight:600}.intro,.description,.small-note{font-size:25rpx;line-height:1.6;color:var(--color-text-2)}.intro{margin-bottom:18rpx}.template{background:var(--color-card);border:1rpx solid var(--color-border);border-left:7rpx solid var(--color-primary);border-radius:18rpx;padding:22rpx 24rpx;margin-bottom:16rpx}.template-top{display:flex;justify-content:space-between;align-items:center;gap:16rpx;font-size:23rpx}.tag{background:var(--color-primary-light);color:var(--color-primary);padding:7rpx 16rpx;border-radius:8rpx}.frequency{color:var(--color-text-2)}.template-title{font-size:32rpx;font-weight:600;margin:16rpx 0 10rpx}.arrow{float:right;font-weight:400}.choose{color:var(--color-primary);font-size:25rpx;margin-top:16rpx}.section-title{font-size:29rpx;font-weight:600;margin-bottom:12rpx}.selected-template,.section-header{display:flex;justify-content:space-between;align-items:center;margin:24rpx 0}.selected-template button{margin:0}.muted{font-size:23rpx;color:var(--color-text-2)}.chips,.choices{display:flex;gap:14rpx;flex-wrap:wrap;margin:16rpx 0 8rpx}.chip{margin:0;padding:14rpx 22rpx;font-size:26rpx;line-height:1.6;background:var(--color-bg);color:var(--color-text-2);border-radius:12rpx;border:2rpx solid transparent}.chip.active{background:var(--color-primary-light);color:var(--color-primary);border-color:var(--color-primary)}.chip::after,.week::after{border:0}.notice{color:#a25c19;font-size:24rpx;line-height:1.7;margin-top:16rpx}.small-note{font-size:23rpx;margin:20rpx 0}.plan-banner{background:var(--color-primary-dark);color:#fff;border-radius:20rpx;padding:30rpx;font-size:25rpx;line-height:1.6}.progress-line{border-top:1rpx solid #ffffff40;padding-top:18rpx;margin-top:24rpx;font-size:24rpx}.plan-actions{display:flex;justify-content:flex-end;gap:14rpx;margin:20rpx 0}.plan-actions button{margin:0}.save-plan{margin:20rpx 0}.week-tabs{display:flex;gap:10rpx;margin-top:30rpx}.week{flex:1;margin:0;padding:16rpx 0;font-size:25rpx;line-height:1.5;background:var(--color-card);border-radius:10rpx}.week.selected{background:var(--color-primary);color:white}.week-note{background:var(--color-primary-light);padding:24rpx;font-size:24rpx;line-height:1.8;margin:18rpx 0 24rpx;border-radius:14rpx;color:var(--color-text)}.day-scroll{width:100%;white-space:nowrap}.days{display:flex;gap:12rpx;padding:4rpx 0 12rpx}.day{flex-shrink:0;min-width:88rpx;padding:16rpx 12rpx;text-align:center;border:2rpx solid var(--color-border);background:var(--color-card);border-radius:12rpx;font-size:25rpx}.day.selected{border-color:var(--color-primary);background:var(--color-primary-light);color:var(--color-primary)}.day-type{font-size:21rpx;margin-top:10rpx}.warmup{color:var(--color-text-2);font-size:24rpx;line-height:1.8;margin-bottom:22rpx}.exercise-card{background:var(--color-card);border:1rpx solid var(--color-border);border-radius:16rpx;padding:22rpx;margin-bottom:14rpx}.exercise-card.completed{border-color:var(--color-primary);background:var(--color-primary-light)}.exercise-title{display:flex;gap:18rpx;align-items:flex-start}.order{font-size:28rpx;color:var(--color-primary);padding-top:3rpx;font-weight:600}.exercise-main{flex:1;min-width:0}.exercise-name{font-size:29rpx;font-weight:600;line-height:1.5;margin-bottom:6rpx}.prescription{display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap;font-size:24rpx;margin:16rpx 0;color:var(--color-text)}.exercise-actions{display:flex;justify-content:space-between;gap:12rpx}.exercise-actions button{margin:0;font-size:23rpx;padding:0 14rpx}.demo-button{color:var(--color-primary);background:var(--color-primary-light)}.done-button{background:var(--color-bg);color:var(--color-text-2)}.evidence{border-top:1rpx solid var(--color-border);margin-top:24rpx;padding-top:20rpx}.source-link{color:var(--color-primary);font-size:24rpx;line-height:1.8;padding-top:16rpx}.rest{padding-top:40rpx;padding-bottom:40rpx}
.chips .chip{width:calc(33.333% - 10rpx);flex:none;margin:0;padding:14rpx 8rpx;min-width:0}.choices .chip{width:calc(50% - 7rpx);flex:none;margin:0;min-width:0;padding:14rpx 8rpx}.week-tabs .week{width:0;min-width:0;margin:0}.exercise-actions button{width:auto;min-width:0}
.load-note{font-size:23rpx;line-height:1.7;color:var(--color-text-2);background:var(--color-bg);padding:16rpx 18rpx;margin:0 0 20rpx;border-radius:10rpx}.week-volume{margin-top:14rpx;padding-top:14rpx;border-top:1rpx solid #2e7d5b26;font-weight:600}

.plan-actions,.exercise-actions{flex-wrap:wrap;align-items:stretch;}.plan-actions button,.exercise-actions button{max-width:100%;white-space:normal;line-height:1.5;padding:12rpx 16rpx;display:flex;align-items:center;justify-content:center;}

.has-next-step{padding-bottom:calc(190rpx + env(safe-area-inset-bottom));}
.next-guide{background:var(--color-primary-light);border:1rpx solid var(--color-border);padding:20rpx 24rpx;border-radius:18rpx;margin-bottom:16rpx;}
.next-guide .section-title{color:var(--color-primary-dark);}
.plan-next-bar{position:fixed;bottom:0;left:0;right:0;z-index:30;padding:14rpx 24rpx calc(14rpx + env(safe-area-inset-bottom));background:var(--color-card);border-top:1rpx solid var(--color-border);}
.next-caption{font-size:22rpx;color:var(--color-text-2);text-align:center;line-height:1.6;margin-bottom:10rpx;}
.plan-next-bar .btn-primary{width:100%;margin:0;line-height:1.5;padding:20rpx 12rpx;}
