p:10rpx;margin-top:30rpx}.week{flex:1;margin:0;padding:16rpx 0;font-size:25rpx;line-height:1.5;background:#fff;border-radius:10rpx}.week.selected{background:#2e7d5b;color:white}.week-note{background:#e8f3ed;padding:24rpx;font-size:24rpx;line-height:1.8;margin:18rpx 0 24rpx;border-radius:14rpx;color:#355947}.day-scroll{width:100%;white-space:nowrap}.days{display:flex;gap:12rpx;padding:4rpx 0 12rpx}.day{flex-shrink:0;min-width:88rpx;padding:16rpx 12rpx;text-align:center;border:2rpx solid #e2e8e4;background:#fff;border-radius:12rpx;font-size:25rpx}.day.selected{border-color:#2e7d5b;background:#e8f3ed;color:#2e7d5b}.day-type{font-size:21rpx;margin-top:10rpx}.warmup{color:#646a73;font-size:24rpx;line-height:1.8;margin-bottom:22rpx}.exercise-card{background:#fff;border:1rpx solid #e2e8e4;border-radius:16rpx;padding:26rpx;margin-bottom:18rpx}.exercise-card.completed{border-color:#2e7d5b;background:#f3faf6}.exercise-title{display:flex;gap:18rpx;align-items:flex-start}.order{font-size:28rpx;color:#2e7d5b;padding-top:3rpx;font-weight:600}.exercise-main{flex:1;min-width:0}.exercise-name{font-size:29rpx;font-weight:600;line-height:1.5;margin-bottom:6rpx}.prescription{display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap;font-size:24rpx;margin:24rpx 0;color:#355947}.exercise-actions{display:flex;justify-content:space-between;gap:12rpx}.exercise-actions button{margin:0;font-size:23rpx;padding:0 14rpx}.demo-button{color:#2e7d5b;background:#e8f3ed}.done-button{background:#f5f6f8;color:#646a73}.evidence{border-top:1rpx solid #dce3df;margin-top:44rpx;padding-top:28rpx}.source-link{color:#2e7d5b;font-size:24rpx;line-height:1.8;padding-top:16rpx}.rest{padding-top:40rpx;padding-bottom:40rpx}
