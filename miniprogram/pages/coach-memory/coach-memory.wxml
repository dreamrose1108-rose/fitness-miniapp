<page-meta page-style="{{appThemeStyle}}" />
<view class="memory-page">
 <view class="intro">教练记住的事</view>
 <view class="help">只保存你确认的长期信息。身高、体重、热量目标和当前计划仍从原记录读取；身体情况请核对后再保存。</view>
 <view class="help">阶段总结按最近14天记录实时更新，不把漏记当成没吃饭或没训练。训练日程目前来自本机，换设备可能不同。</view>
 <view class="notice" wx:if="{{notice}}">{{notice}}</view>
 <view wx:if="{{loading}}" class="help">正在读取记忆…</view>
 <view wx:elif="{{error}}"><text>{{error}}</text><button bindtap="load">重试</button></view>
 <block wx:else>
  <view wx:for="{{rows}}" wx:key="key" class="memory-card">
   <view class="title">{{item.label}}</view>
   <textarea value="{{item.value}}" data-index="{{index}}" bindinput="onInput" maxlength="160" disabled="{{saving}}" placeholder="填写希望教练记住的长期信息" auto-height />
   <view class="help" wx:if="{{item.updated}}">上次确认：{{item.updated}}（北京时间）</view>
   <view class="actions"><button data-index="{{index}}" bindtap="save" disabled="{{saving || !item.value}}">确认保存</button><button class="secondary" data-index="{{index}}" bindtap="forget" disabled="{{saving || !item.saved}}">忘记</button></view>
  </view>
 </block>
 <button class="back" bindtap="back">返回 AI 教练</button>
</view>
