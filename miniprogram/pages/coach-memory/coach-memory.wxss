page{background:var(--color-bg);color:var(--color-text);}.memory-page{padding:28rpx;padding-bottom:calc(40rpx + env(safe-area-inset-bottom));}.intro{font-size:36rpx;font-weight:600;}.help{font-size:24rpx;line-height:1.7;color:var(--color-text-2);margin:16rpx 0;}.notice{padding:22rpx;border-radius:16rpx;background:var(--color-primary-light);color:var(--color-primary);line-height:1.7;margin:20rpx 0;}.memory-card{background:var(--color-card);border-radius:24rpx;padding:24rpx;margin:16rpx 0;}.title{font-size:30rpx;font-weight:600;margin-bottom:14rpx;}textarea{box-sizing:border-box;width:100%;min-height:120rpx;padding:20rpx;background:var(--color-bg);border-radius:16rpx;font-size:28rpx;line-height:1.7;color:var(--color-text);}.actions{display:flex;gap:16rpx;margin-top:20rpx;}.actions button{flex:1;margin:0;padding:16rpx 12rpx;line-height:1.6;font-size:28rpx;background:var(--color-primary);color:white;}.actions .secondary,.back{background:var(--color-bg);color:var(--color-primary);}.back{margin-top:32rpx;}button::after{border-color:var(--color-border);}
