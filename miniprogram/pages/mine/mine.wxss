.user-card { display: flex; align-items: center; }
.user-avatar {
  width: 110rpx; height: 110rpx; border-radius: 50%;
  background: var(--color-primary-light); color: var(--color-primary);
  display: flex; align-items: center; justify-content: center;
  font-size: 44rpx; font-weight: 600; margin-right: 28rpx;
}
.user-name { display: block; font-size: 34rpx; font-weight: 600; }
.user-sub { display: block; font-size: 24rpx; margin-top: 10rpx; }

.setting-row {
  display: flex; align-items: center; justify-content: space-between;
  padding: 24rpx 0; border-bottom: 1rpx solid var(--color-border);
  font-size: 28rpx;
}
.setting-row:last-child { border-bottom: none; }
.setting-val { display: flex; align-items: center; color: var(--color-text-2); }
.arrow { color: var(--color-text-3); font-size: 36rpx; margin-left: 12rpx; }

.about-card { font-size: 24rpx; line-height: 1.7; }
