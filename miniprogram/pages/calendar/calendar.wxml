<view class="page">
 <view class="card"><view class="month-nav"><button size="mini" data-offset="-1" bindtap="changeMonth">上月</button><text>{{month}}</text><button size="mini" data-offset="1" bindtap="changeMonth" disabled="{{month >= maxMonth}}">下月</button></view>
 <view wx:if="{{error}}" class="notice" bindtap="load">{{error}}</view><view wx:elif="{{loading}}" class="notice">正在加载日历…</view>
 <block wx:else><view class="calendar-grid"><view wx:for="{{weekdays}}" wx:key="*this" class="weekday">{{item}}</view></view><view class="calendar-grid"><view wx:for="{{cells}}" wx:key="key" class="day {{item.date === selected ? 'selected' : ''}} {{item.future ? 'future' : ''}}" data-date="{{item.date}}" bindtap="select"><text>{{item.day}}</text><text wx:if="{{item.hasPlan}}" class="plan-mark">练</text><view wx:if="{{item.hasRecord}}" class="mark"></view><text wx:elif="{{item.today}}" class="today">今</text></view></view><view class="legend">“练”表示已安排训练；圆点表示已有实际记录</view></block></view>
<view wx:if="{{scheduleError}}" class="card notice">{{scheduleError}}</view><view class="card"><view class="card-title">{{selected}} · 训练安排</view><view wx:if="{{planned}}">{{planned.title}} · {{planned.exercises.length}} 个动作</view><view wx:else class="legend">这天没有保存的训练安排</view><button size="mini" bindtap="schedule">查看与管理训练日程</button></view>
 <block wx:if="{{!loading && !error}}"><view class="card"><view class="card-title">{{selected}} · 当天记录</view><view class="line"><text>饮食摄入</text><text>{{detail.dietCount ? detail.diet + ' kcal' : '未记录'}}</text></view><view class="line"><text>运动消耗</text><text>{{detail.exerciseCount ? detail.exercise + ' kcal' : '未记录'}}</text></view><view class="line"><text>体重</text><text>{{detail.bodyCount ? detail.body + ' kg' : '未记录'}}</text></view><view class="line"><text>饮水</text><text>{{detail.waterCount ? detail.water + ' ml' : '未记录'}}</text></view></view>
 <view class="card"><view class="card-title">近七天回顾</view><view class="text-2">{{weekLabel}}</view><view class="headline">{{review.recordedDays}}<text> / 7 天有记录</text></view><view class="line"><text>已记录饮食日均摄入</text><text>{{review.avgIntake === null ? '--' : review.avgIntake}} kcal</text></view><view class="line"><text>运动 {{review.exerciseDays}} 天 · 已记消耗</text><text>{{review.burned}} kcal</text></view><view class="line"><text>饮水 {{review.waterDays}} 天</text><text>{{review.waterTotal}} ml</text></view><view class="line"><text>首末记录体重变化</text><text>{{review.weightChange === null ? '--' : review.weightChange}} kg</text></view><view class="legend">饮食均值仅含 {{review.dietDays}} 个有饮食记录的日期；未记录不代表零摄入。体重至少两天有记录才比较。未填写热量的运动不计入消耗汇总。</view></view></block>
</view>
