.month-nav,.line{display:flex;align-items:center;justify-content:space-between}.month-nav{margin-bottom:24rpx;font-weight:600}.month-nav button{margin:0;font-weight:400}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr)}.weekday{text-align:center;color:var(--color-text-2);padding:12rpx 0}.day{height:86rpx;display:flex;flex-direction:column;align-items:center;justify-content:center;border-radius:12rpx}.day.selected{background:var(--color-primary);color:white}.day.future{color:#9aa0a6}.mark{width:8rpx;height:8rpx;background:var(--color-primary);border-radius:50%;margin-top:6rpx}.selected .mark{background:white}.today{font-size:18rpx}.legend{font-size:23rpx;color:var(--color-text-2);line-height:1.6;margin-top:22rpx}.line{padding:18rpx 0;border-bottom:1rpx solid var(--color-border)}.headline{font-size:60rpx;color:var(--color-primary);margin:20rpx 0}.headline text{font-size:26rpx}.notice{padding:30rpx 0}

.plan-mark{font-size:18rpx;color:var(--color-primary)}.selected .plan-mark{color:white}.day{position:relative}.day .plan-mark{position:absolute;right:6rpx;top:5rpx}
