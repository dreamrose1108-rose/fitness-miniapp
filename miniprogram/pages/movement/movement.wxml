<view class="page"><view wx:if="{{!item}}" class="card">动作不存在，请返回动作库重新选择。</view><block wx:else>
<view class="category">{{item.bodyLabel}} / {{item.targetLabel}}</view><view class="title">{{item.displayName}}</view><view wx:if="{{item.displayName !== item.name}}" class="english">{{item.name}}</view><view class="equipment">器械：{{item.equipmentLabel}}</view>
<view class="card demo" wx:if="{{mediaInfo}}"><view class="card-title">动作演示</view><view wx:if="{{loading}}" class="media-state">正在加载示范…</view><view wx:if="{{mediaError}}" class="media-state">{{mediaError}}<button size="mini" bindtap="retry">重新加载</button></view>
<block wx:if="{{!loading && !mediaError}}"><block wx:if="{{images.length}}"><swiper class="demo-frames" current="{{frame}}" bindchange="changeFrame" duration="0"><swiper-item wx:for="{{images}}" wx:key="*this"><image class="demo-image" src="{{item}}" mode="aspectFit" data-index="{{index}}" bindload="imageLoaded" binderror="imageFailed" bindtap="preview"/></swiper-item></swiper><view class="frame-caption">姿势 {{frame + 1}} / {{images.length}} · 点击图片放大</view><view class="frame-controls"><button size="mini" data-delta="-1" bindtap="step">上一帧</button><button wx:if="{{images.length > 1}}" class="play" size="mini" bindtap="togglePlay">{{playing ? '暂停演示' : '循环演示'}}</button><button size="mini" data-delta="1" bindtap="step">下一帧</button></view><view class="media-note">分解图循环展示关键姿势，不代表完整运动轨迹或训练节奏。</view></block>
<block wx:if="{{video}}"><view class="video-title">连续动作视频</view><video wx:if="{{!videoError}}" id="movementVideo" class="demo-video" src="{{video}}" controls show-fullscreen-btn object-fit="contain" loop binderror="videoFailed"/><view wx:else class="media-state">视频加载失败<button size="mini" bindtap="retry">重试</button></view></block></block>
<view class="media-credit"><text wx:if="{{mediaInfo.photoSource}}">分解图：free-exercise-db · Unlicense</text><text wx:if="{{mediaInfo.videoAuthor}}">视频：{{mediaInfo.videoTitle}} / {{mediaInfo.videoAuthor}} · {{mediaInfo.videoLicense}}（转码压缩，部分裁去开头空镜）</text><text class="source-link" bindtap="copySource">复制素材来源及许可链接</text></view></view>
<view wx:else class="card note">这个动作的演示素材正在补充中，目前可查看中文步骤。</view>
<button class="favorite" bindtap="favorite">{{favorite ? '已收藏到本机 · 点击取消' : '收藏到本机'}}</button>
<view class="card"><view class="card-title">动作步骤</view><view wx:for="{{item.steps}}" wx:key="index" class="step"><text class="number">{{index + 1}}</text><text class="instruction">{{item}}</text></view></view>
<button class="btn-primary" bindtap="record">记录这个动作</button><view class="hint">记录时填写时长，消耗热量可选填。</view>
<view wx:if="{{item.isSupplemental}}" class="source">补充动作 · 中文步骤由卡路喵整理</view><block wx:else><view class="source" bindtap="license">基础文字数据 © 2026 Hasan Emir Yıldırım<br/>exercises-dataset · MIT 许可 {{showLicense ? '收起' : '查看'}}</view><text wx:if="{{showLicense}}" class="license" selectable>{{license}}</text></block></block></view>
