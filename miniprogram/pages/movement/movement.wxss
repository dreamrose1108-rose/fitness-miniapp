.category{font-size:24rpx;color:var(--color-primary);margin:12rpx 0 24rpx}.title{font-size:40rpx;line-height:1.4;font-weight:600;overflow-wrap:break-word}.english,.equipment{margin-top:16rpx;color:var(--color-text-2);font-size:26rpx}.favorite{margin:28rpx 0;background:var(--color-primary-light);color:var(--color-primary);font-size:27rpx}.step{display:flex;gap:20rpx;margin:24rpx 0}.number{flex-shrink:0;background:var(--color-primary-light);color:var(--color-primary);border-radius:50%;width:46rpx;height:46rpx;text-align:center;line-height:46rpx;font-size:25rpx}.instruction{font-size:28rpx;line-height:1.8;flex:1}.note,.hint,.source{font-size:24rpx;line-height:1.8;color:var(--color-text-2)}.hint{margin:18rpx 0 34rpx}.source{padding:20rpx 0;color:var(--color-primary)}.license{display:block;white-space:pre-wrap;font-size:22rpx;line-height:1.6;overflow-wrap:break-word;padding:20rpx;background:white}
.demo{margin-top:28rpx}.demo-frames{height:440rpx;background:#fff;margin-top:20rpx}.demo-image{width:100%;height:100%}.frame-caption{text-align:center;color:var(--color-text-2);font-size:24rpx;margin:14rpx 0}.frame-controls{display:flex;gap:12rpx;justify-content:center}.frame-controls button{margin:0;font-size:24rpx}.frame-controls .play{background:var(--color-primary);color:white}.media-note,.media-credit{font-size:22rpx;line-height:1.7;color:var(--color-text-2);margin-top:20rpx}.media-credit text{display:block}.source-link{color:var(--color-primary);padding-top:10rpx}.demo-video{width:100%;height:390rpx;background:#111}.video-title{font-size:28rpx;font-weight:600;margin:28rpx 0 16rpx}.media-state{padding:40rpx 0;text-align:center;color:var(--color-text-2);font-size:26rpx}.media-state button{display:block;width:220rpx;margin-top:16rpx}

.gif-image{display:block;width:100%;height:480rpx;background:#fff;}
