.step{font-size:24rpx;color:var(--color-primary);margin:12rpx 0 28rpx}.title{font-size:42rpx;font-weight:600;margin-bottom:20rpx}.subtitle{font-size:25rpx;line-height:1.7;color:var(--color-text-2);margin-bottom:24rpx}.choice{display:flex;justify-content:space-between;padding:32rpx;background:var(--color-card);border:2rpx solid transparent;border-radius:16rpx;margin-bottom:22rpx}.choice.active{border-color:var(--color-primary);background:var(--color-primary-light);color:var(--color-primary)}.choice text:last-child{font-size:24rpx}.field{padding:16rpx 0}.field text{font-size:26rpx}.field input{height:80rpx;line-height:80rpx;background:var(--color-bg);margin-top:12rpx;border-radius:8rpx;padding:0 16rpx;min-width:0}.back{font-size:28rpx;background:transparent;color:var(--color-text-2);margin-top:16rpx}.back::after{border:none}
