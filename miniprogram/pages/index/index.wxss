.home-page .training-bottom,.home-page .empty-copy,.home-page .streak-note,
.home-page .tip,.home-page .welcome-label,.home-page .welcome-note,
.home-page .theme-button text { color:var(--color-text-2); }
.home-page .habit-note { color:#58624e; }
.home-page .training-cta { background:var(--color-primary-dark);color:#fff; }
.theme-cat .energy-label,.theme-cat .energy-number text,.theme-cat .target-block,
.theme-cat .target-block view text,.theme-cat .energy-stats,.theme-cat .energy-caption,
.theme-cat .macro-label,.theme-cat .macro-value text { color:#715238; }
