<page-meta page-style="{{appThemeStyle}}" />
<view class="page home-page theme-{{theme}}">
  <view class="greeting">
    <view><text class="date">{{todayLabel}}</text><text class="hello">{{theme === 'cat' ? '今天也要元气满满喵' : '把健康，放进每一天'}}</text></view>
    <view class="header-actions"><picker mode="selector" range="{{themeNames}}" value="{{themeIndex}}" bindchange="changeTheme"><view class="theme-button">换主题<text>{{themeNames[themeIndex]}} ▾</text></view></picker><view class="profile-link" bindtap="goMine" hover-class="pressed">我的<text>›</text></view></view>
  </view>

  <view wx:if="{{theme === 'cat'}}" class="cat-welcome">
    <view class="welcome-copy"><text class="welcome-label">卡路喵的每日陪伴</text><text class="welcome-title">好好吃饭，好好运动</text><text class="welcome-note">不着急，我们一起慢慢变好。</text></view>
    <view class="mascot" aria-hidden="true">
      <view class="cat-tail"></view><view class="cat-body"></view>
      <view class="cat-ear ear-left"><view></view></view><view class="cat-ear ear-right"><view></view></view>
      <view class="cat-head"><view class="cat-stripe stripe-one"></view><view class="cat-stripe stripe-two"></view><view class="cat-eye eye-left"></view><view class="cat-eye eye-right"></view><view class="cat-cheek cheek-left"></view><view class="cat-cheek cheek-right"></view><view class="cat-nose"></view><view class="cat-mouth mouth-left"></view><view class="cat-mouth mouth-right"></view><view class="whisker whisker-left"></view><view class="whisker whisker-right"></view></view>
      <view class="cat-paw paw-left"></view><view class="cat-paw paw-right"></view>
    </view>
  </view>
  <view class="energy-card">
    <view class="energy-top"><text>今日热量</text><view class="energy-tag"><view class="paw-print"><view></view><view></view><view></view><view></view><view></view></view><text>今日能量账本</text></view></view>
    <view class="energy-main"><view><text class="energy-label">净摄入</text><view class="energy-number">{{summary.net}}<text>kcal</text></view></view><view class="target-block"><text>每日摄入目标</text><view>{{target}}<text> kcal</text></view></view></view>
    <view class="energy-stats"><text>摄入 <text class="stat-value">{{summary.intake}}</text></text><text>运动消耗 <text class="stat-value">{{summary.burned}}</text></text></view>
    <view class="energy-track"><view class="energy-fill" style="width: {{intakePercent}}%"></view></view>
    <view class="energy-caption"><text>摄入占目标比例</text><text>{{intakePercent}}%</text></view>
    <view class="macro-row">
      <view><text class="macro-label">蛋白质</text><view class="macro-value">{{summary.proteinG || 0}}<text> g</text></view></view>
      <view><text class="macro-label">碳水</text><view class="macro-value">{{summary.carbG || 0}}<text> g</text></view></view>
      <view><text class="macro-label">脂肪</text><view class="macro-value">{{summary.fatG || 0}}<text> g</text></view></view>
    </view>
  </view>

  <view class="quick-grid">
    <view class="quick-item" bindtap="goDiet" hover-class="pressed"><view class="quick-symbol diet-symbol">食</view><text>记录饮食</text></view>
    <view class="quick-item" bindtap="goExercise" hover-class="pressed"><view class="quick-symbol exercise-symbol">动</view><text>记录运动</text></view>
    <view class="quick-item" bindtap="goTrend" hover-class="pressed"><view class="quick-symbol trend-symbol">势</view><text>查看趋势</text></view>
    <view class="quick-item" bindtap="goCoach" hover-class="pressed"><view class="quick-symbol coach-symbol">AI</view><text>喵教练</text></view>
  </view>

  <view class="section-heading"><text>今日训练</text><text class="section-note">{{theme === 'cat' ? '和喵一起，伸个懒腰' : '留一点时间，给自己'}}</text></view>
  <view class="training-card" bindtap="goTraining" hover-class="pressed">
    <block wx:if="{{todayTraining}}">
      <view class="training-top"><text class="training-plan">{{todayTraining.planTitle || '今日安排'}}</text><text class="status-pill">{{todayTraining.finished ? '已结束' : todayTraining.started ? '进行中' : '待开始'}}</text></view>
      <view class="training-title">{{todayTraining.title}}</view>
      <view class="training-actions"><text wx:for="{{todayTraining.names}}" wx:key="*this">{{item}}</text></view>
      <view class="training-progress"><view style="width: {{todayTraining.total ? todayTraining.done / todayTraining.total * 100 : 0}}%"></view></view>
      <view class="training-bottom"><text>{{todayTraining.done}} / {{todayTraining.total}} 个动作完成</text><view class="training-cta">{{todayTraining.finished ? '查看训练' : todayTraining.started ? '继续训练' : '开始训练'}} <text>↗</text></view></view>
    </block>
    <block wx:else><view class="training-top"><text class="training-plan">今天的运动时间</text><text class="status-pill">待安排</text></view><view class="training-title">从适合自己的节奏开始</view><view class="empty-copy">选择一个计划，开启今天的训练。</view><view class="training-bottom"><text>循序渐进，每一步都算数</text><view class="training-cta">去安排 <text>↗</text></view></view></block>
  </view>

  <view class="section-heading"><text>日常小习惯</text><text class="section-note">照顾好自己，也是一种进步</text></view>
  <view class="habit-grid">
    <navigator url="/pages/water/water" class="habit-card water-card" hover-class="pressed"><view class="habit-top"><text>饮水记录</text><text>↗</text></view><view class="habit-title">{{theme === 'cat' ? '该喝水啦喵' : '记得喝水'}}</view><view class="habit-note">记一杯水，补充活力</view><view class="habit-action">去记录 ›</view></navigator>
    <view class="habit-card weight-card" bindtap="onRecordWeight" hover-class="pressed"><view class="habit-top"><text>当前体重</text><text>＋</text></view><view class="weight-number">{{summary.latestWeight || '--'}}<text> kg</text></view><view class="habit-note">关注身体的每一点变化</view><view class="habit-action">记录体重 ›</view></view>
  </view>

  <view class="streak-card"><view class="streak-number">{{streak.streak}}<text>天</text></view><view class="streak-info"><view class="streak-title">{{theme === 'cat' ? '每天一小步，喵陪你进步' : '连续打卡，慢慢变好'}}</view><view class="streak-note">累计 {{streak.totalDays}} 天 · {{streak.todayChecked ? '今天已打卡' : '今天也要记得记录'}}</view><view wx:if="{{streak.achieved.length}}" class="streak-badges"><text wx:for="{{streak.achieved}}" wx:key="*this">{{item}}天</text></view></view></view>
  <view class="tip">数据仅供健康管理参考，不构成医疗建议</view>
</view>
