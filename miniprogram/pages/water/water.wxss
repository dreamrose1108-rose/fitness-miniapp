.date-row,.record-row{display:flex;justify-content:space-between;align-items:center;padding:20rpx 0}.date-row text,.goal-link{color:var(--color-primary)}.water-hero{border-top:6rpx solid var(--color-primary)}.volume{font-size:76rpx;font-weight:600;margin:20rpx 0}.volume text{font-size:28rpx;font-weight:400;color:var(--color-text-2)}progress{margin-top:24rpx}.goal-link{margin-top:24rpx}.presets,.custom{display:flex;gap:12rpx}.presets button{flex:1;min-width:0;height:72rpx;line-height:72rpx;margin:0;display:flex;align-items:center;justify-content:center;font-size:25rpx;padding:0;background:var(--color-primary-light);color:var(--color-primary)}.custom{margin-top:24rpx;align-items:center}.custom input{min-width:0;flex:1;background:var(--color-bg);height:80rpx;line-height:80rpx;padding:0 16rpx}.custom button{font-size:28rpx;margin:0;height:80rpx;line-height:80rpx;padding:0 28rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}.record-row{border-bottom:1rpx solid var(--color-border)}.record-row button{margin:0;color:var(--color-text-2)}
