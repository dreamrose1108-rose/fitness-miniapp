.eyebrow{color:var(--color-primary);font-size:24rpx;margin:12rpx 0}.title{font-size:38rpx;font-weight:600;margin:16rpx 0 28rpx}.search{height:92rpx;padding:20rpx 24rpx;background:var(--color-card);border:1rpx solid var(--color-border);border-radius:14rpx;font-size:27rpx}.filters{display:flex;flex-wrap:wrap;gap:14rpx;margin:22rpx 0}.filters picker{background:var(--color-primary-light);color:var(--color-primary);border-radius:12rpx;padding:18rpx;font-size:24rpx}.result-bar{display:flex;justify-content:space-between;align-items:center;margin:24rpx 0;font-size:25rpx;color:var(--color-text-2)}.result-bar button{margin:0;font-size:24rpx}.result-bar .active{background:var(--color-primary);color:white}.movement{background:var(--color-card);padding:28rpx;margin-bottom:16rpx;border-radius:16rpx}.movement-name{font-size:30rpx;font-weight:600;overflow-wrap:break-word;line-height:1.5}.english{font-size:24rpx;color:var(--color-text-2);margin-top:10rpx}.tags{display:flex;flex-wrap:wrap;gap:12rpx;margin:18rpx 0}.tags text{font-size:23rpx;color:var(--color-text-2);background:var(--color-bg);padding:6rpx 12rpx;border-radius:6rpx}.link{color:var(--color-primary);font-size:24rpx}.source{font-size:22rpx;color:var(--color-text-2);line-height:1.8;margin-top:28rpx}.more{font-size:28rpx;background:var(--color-primary-light);color:var(--color-primary)}.empty button{margin-top:24rpx}

.thumbnail{float:right;width:150rpx;height:140rpx;margin:0 0 14rpx 18rpx;background:var(--color-card);border-radius:12rpx}.movement{min-height:140rpx;overflow:hidden}.demo-filter{margin-top:24rpx;background:var(--color-primary-light);color:var(--color-primary)}.demo-filter.active{background:var(--color-primary);color:white}
