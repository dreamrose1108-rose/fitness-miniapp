<page-meta page-style="{{appThemeStyle}}" />
<view class="page"><view class="eyebrow">动作库 · {{totalLibrary}} 个动作</view><view class="title">找到今天要练的动作</view><input class="search" placeholder="搜索中英文名称、部位或关键词" value="{{query}}" bindinput="input" maxlength="80" confirm-type="search"/>
 <view class="filters"><picker range="{{bodyOptions}}" range-key="label" value="{{bodyIndex}}" data-field="body" bindchange="filter"><view>部位 · {{bodyOptions[bodyIndex].label}} ▾</view></picker><picker range="{{equipmentOptions}}" range-key="label" value="{{equipmentIndex}}" data-field="equipment" bindchange="filter"><view>器械 · {{equipmentOptions[equipmentIndex].label}} ▾</view></picker><picker range="{{targetOptions}}" range-key="label" value="{{targetIndex}}" data-field="target" bindchange="filter"><view>肌群 · {{targetOptions[targetIndex].label}} ▾</view></picker></view>
 <button class="demo-filter {{mediaOnly ? 'active' : ''}}" size="mini" bindtap="demos">{{mediaOnly ? '已选有演示' : '只看有演示'}} · {{mediaCount}}</button><view class="result-bar"><text>{{total}} 个匹配动作</text><button size="mini" class="{{favoritesOnly ? 'active' : ''}}" bindtap="favorites">{{favoritesOnly ? '已选本机收藏' : '本机收藏'}}</button></view>
 <view wx:if="{{!total}}" class="card empty"><view>没有匹配的动作</view><button size="mini" bindtap="clear">清除筛选</button></view>
 <view wx:for="{{results}}" wx:key="id" class="movement" data-id="{{item.id}}" bindtap="open"><image wx:if="{{thumbnails[item.id]}}" class="thumbnail" src="{{thumbnails[item.id]}}" mode="aspectFit" lazy-load/><view class="movement-name">{{item.name}}</view><view wx:if="{{item.name !== item.englishName}}" class="english">{{item.englishName}}</view><view class="tags"><text>{{item.body}}</text><text>{{item.target}}</text><text>{{item.equipment}}</text></view><text class="link">{{item.hasVideo ? '图片 / 视频演示' : item.hasMedia ? '图片 / 分帧演示' : '中文步骤 · 演示待补充'}} ›</text></view>
 <button wx:if="{{hasMore}}" class="more" bindtap="more">加载更多</button><view class="source">数据：exercises-dataset · MIT（文字数据）<br/>全部动作支持中文名称搜索，保留基础动作英文原名。</view>
</view>
