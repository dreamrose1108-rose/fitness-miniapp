.schedule-page{padding:24rpx}
.heading{font-size:40rpx;font-weight:700;margin-bottom:8rpx}
.hint{font-size:24rpx;color:var(--color-text-3);margin-bottom:20rpx}
.notice{padding:20rpx;margin-bottom:16rpx;border-radius:12rpx;font-size:26rpx}
.notice.error{background:#fdf0ee;color:var(--color-danger)}
.notice.ok{background:var(--color-primary-light);color:var(--color-primary)}
.toolbar{display:flex;gap:12rpx;margin-bottom:20rpx}
.toolbar button{flex:1;font-size:24rpx;border-radius:20rpx;margin:0}
.empty-card{display:flex;flex-direction:column;align-items:center;padding:80rpx 40rpx}
.empty-icon{font-size:80rpx;margin-bottom:20rpx}
.empty-title{font-size:32rpx;font-weight:600;margin-bottom:8rpx}
.empty-btn{margin-top:24rpx;width:60%!important}
.draft-card{display:flex;flex-direction:column;align-items:center;margin-bottom:20rpx}
.plan-icon{font-size:60rpx;margin-bottom:12rpx}
.date-btn{background:var(--color-primary-light);color:var(--color-primary);padding:14rpx 28rpx;border-radius:20rpx;font-size:26rpx;margin:12rpx 0}
.session-card{background:var(--color-card);border-radius:16rpx;padding:0;margin-bottom:20rpx;overflow:hidden;border:1rpx solid var(--color-border)}
.session-card.is-today{border:2rpx solid var(--color-primary)}
.session-card.is-past{opacity:.6}
.session-header{display:flex;align-items:center;justify-content:space-between;padding:20rpx 24rpx;background:var(--color-bg);border-bottom:1rpx solid var(--color-border)}
.session-card.is-today .session-header{background:var(--color-primary-light)}
.date-label{font-size:26rpx;font-weight:600;color:var(--color-text-2)}
.date-label.today{color:var(--color-primary)}
.session-badge{font-size:22rpx;color:var(--color-primary);background:var(--color-primary-light);padding:4rpx 16rpx;border-radius:16rpx}
.session-badge.in-progress{color:var(--color-warning);background:#fff7e8}
.session-body{padding:20rpx 24rpx 12rpx}
.session-title{font-size:32rpx;font-weight:600}
.session-plan{font-size:24rpx;margin-top:4rpx}
.progress-track{height:8rpx;background:var(--color-bg);margin:0 24rpx;border-radius:4rpx;overflow:hidden}
.progress-fill{height:100%;background:var(--color-primary);border-radius:4rpx;transition:width .3s}
.progress-count{font-size:22rpx;padding:8rpx 24rpx 0}
.exercise-list{padding:16rpx 24rpx}
.exercise-item{display:flex;align-items:center;justify-content:space-between;padding:16rpx 0;border-bottom:1rpx solid var(--color-border)}
.exercise-item:last-child{border-bottom:none}
.exercise-item.is-done .exercise-name{text-decoration:line-through;color:var(--color-text-3)}
.exercise-item.is-done .exercise-detail{color:var(--color-text-3)}
.exercise-left{display:flex;align-items:center;flex:1}
.exercise-num{width:48rpx;height:48rpx;border-radius:50%;background:var(--color-bg);color:var(--color-text-2);display:flex;align-items:center;justify-content:center;font-size:24rpx;font-weight:600;margin-right:16rpx;flex-shrink:0}
.exercise-num.done{background:var(--color-primary);color:#fff}
.exercise-info{flex:1}
.exercise-name{font-size:28rpx;font-weight:500}
.exercise-detail{font-size:22rpx;color:var(--color-text-3);margin-top:4rpx}
.done-btn{background:var(--color-bg);color:var(--color-text-2);font-size:24rpx;border-radius:20rpx;padding:8rpx 24rpx;margin:0;line-height:1.5;flex-shrink:0}
.done-btn.is-done{background:var(--color-primary);color:#fff}
.done-btn::after{border:none}
.session-footer{padding:12rpx 24rpx 16rpx;display:flex;justify-content:flex-end}
.remove-btn{font-size:22rpx;color:var(--color-danger);background:none;padding:8rpx 16rpx}
.remove-btn::after{border:none}
.save-btn{margin-top:24rpx}

/* 组进度点 */
.set-dots{display:flex;gap:8rpx;margin-top:8rpx}
.set-dot{font-size:28rpx;color:var(--color-text-3);padding:4rpx 8rpx}
.set-dot.done{color:var(--color-primary)}

/* 组间休息倒计时 */
.rest-overlay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.75);z-index:999;display:flex;align-items:center;justify-content:center}
.rest-card{background:var(--color-card);border-radius:24rpx;padding:48rpx 64rpx;display:flex;flex-direction:column;align-items:center;min-width:400rpx}
.rest-label{font-size:26rpx;color:var(--color-text-2);margin-bottom:16rpx}
.rest-count{font-size:120rpx;font-weight:700;color:var(--color-primary);line-height:1}
.rest-unit{font-size:24rpx;color:var(--color-text-3);margin-top:8rpx;margin-bottom:24rpx}
.rest-bar{width:100%;height:10rpx;background:var(--color-bg);border-radius:5rpx;overflow:hidden;margin-bottom:24rpx}
.rest-bar-fill{height:100%;background:var(--color-primary);border-radius:5rpx;transition:width 1s linear}
.rest-skip-btn{background:var(--color-primary)!important;color:#fff!important;font-size:26rpx;border-radius:24rpx;padding:12rpx 40rpx}
.session-start{margin:20rpx 24rpx;}
.exercise-controls{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx;align-items:center;}
.exercise-controls button{margin:0;font-size:24rpx;}
.exercise-controls .set-complete{background:var(--color-primary);color:white;}
.toolbar{flex-wrap:wrap;gap:12rpx;}
