.heading{font-size:40rpx;font-weight:600;margin:20rpx 0}.hint{font-size:24rpx;line-height:1.8;color:var(--color-text-2);margin:12rpx 0}.notice{padding:20rpx;background:var(--color-primary-light);margin:20rpx 0;border-radius:12rpx}.error{color:var(--color-danger);background:#fdf0ee}.date-picker{padding:18rpx 0;color:var(--color-primary);font-size:27rpx}.toolbar{display:flex;gap:20rpx;margin:24rpx 0}.toolbar button{margin:0;font-size:24rpx}.exercise{padding:20rpx 0;border-bottom:1rpx solid var(--color-border)}.exercise-name{font-size:29rpx;font-weight:500;color:var(--color-primary)}.done{font-size:24rpx;margin:12rpx 0 0;color:var(--color-primary);background:var(--color-primary-light)}.remove{margin:28rpx 0 0;color:var(--color-text-2);font-size:24rpx}.save{margin:32rpx 0 48rpx}
