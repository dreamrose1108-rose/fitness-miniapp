<page-meta page-style="{{appThemeStyle}}" />
<view class="page schedule-page">
 <view class="heading">{{todayOnly ? '今日训练' : draft ? '确认日期，再开始训练' : '我的训练日程'}}</view>
 <view class="hint">组数与完成进度保存在本机 · 打卡不自动计入热量</view>
 <view wx:if="{{error}}" class="notice error">{{error}}</view>
 <view wx:if="{{success}}" class="notice ok">{{success}}</view>
 <view wx:if="{{draft}}" class="card draft-card">
  <view class="card-title">{{draft.title}}</view><view class="hint">{{draft.notes}}</view>
  <picker mode="date" value="{{start}}" start="{{today}}" end="{{maxDate}}" bindchange="start"><view class="date-btn">开始日期 {{start}} · 修改</view></picker>
  <view class="hint">可逐日调整，已有训练不会被覆盖。保存后才能开始训练。</view>
 </view>
 <view wx:if="{{!draft && !todayOnly}}" class="toolbar">
  <button size="mini" bindtap="past">{{showPast ? '仅看今后' : '查看历史'}}</button><button size="mini" bindtap="calendar">日历</button><button size="mini" bindtap="coach">AI 新计划</button><button size="mini" bindtap="templates">选模板</button>
 </view>
 <view wx:if="{{!rows.length && !draft && !error}}" class="card empty-card">
  <view class="empty-title">{{todayOnly ? '今天还没有训练安排' : '还没有训练日程'}}</view><view class="hint">可以让 AI 按你的条件生成，也可以直接选择训练模板。</view>
  <block wx:if="{{todayOnly}}"><button class="btn-primary empty-btn" bindtap="templates">选择计划</button><button bindtap="freeTraining">自由运动记录</button></block><block wx:else><button class="btn-primary empty-btn" bindtap="coach">让 AI 制定计划</button><button bindtap="templates">选择训练模板</button></block>
 </view>
 <view wx:for="{{rows}}" wx:key="sourceKey" class="session-card {{item.isToday ? 'is-today' : ''}}">
  <view class="session-header">
   <picker wx:if="{{draft}}" mode="date" value="{{item.date}}" start="{{today}}" end="{{maxDate}}" data-index="{{index}}" bindchange="day"><view class="date-label">{{item.dateLabel}} · 改期</view></picker>
   <view wx:else class="date-label">{{item.dateLabel}}</view>
   <view class="session-badge">{{item.finishedAt ? '已结束' : item.startedAt ? '进行中' : '未开始'}}</view>
  </view>
  <view class="session-body"><view class="session-eyebrow">{{item.isToday ? '今天练什么' : '本次训练内容'}}</view><view class="session-title">{{item.displayTitle}}</view><view class="session-overview">{{item.exercises.length}} 个动作 · 计划 {{item.plannedSets}} 组</view><view class="hint">计划：{{item.planTitle}}</view></view>
  <block wx:if="{{!draft}}">
   <view class="progress-count">实际完成 {{item.actualSets}} 组 · 计划 {{item.plannedSets}} 组<text wx:if="{{item.skippedSets}}"> · 跳过 {{item.skippedSets}} 组</text></view>
   <button wx:if="{{item.isToday && !item.finishedAt && !item.active}}" class="btn-primary session-start" data-key="{{item.sourceKey}}" bindtap="begin">{{item.startedAt ? '继续训练' : '开始训练'}}</button>
   <view wx:if="{{!item.isToday && !item.finishedAt}}" class="hint session-start">{{item.isPast ? '历史安排，仅供查看' : '尚未到训练日期，可先查看动作演示'}}</view>
  </block>
  <view class="exercise-list">
   <view wx:for="{{item.exercises}}" wx:for-item="exercise" wx:for-index="eidx" wx:key="id" class="exercise-item {{exercise.done ? 'is-done' : ''}}">
    <view class="exercise-info">
     <view class="exercise-heading"><text class="exercise-step">动作 {{eidx + 1}}</text><text wx:if="{{!draft && exercise.handled}}" class="exercise-status">{{exercise.done ? '已完成' : '本次已结束'}}</text></view><view class="exercise-name">{{exercise.plainName}}</view><view wx:if="{{exercise.plainName !== exercise.originalName}}" class="exercise-original">动作原名：{{exercise.originalName}}</view><view wx:if="{{exercise.explanation}}" class="exercise-explanation">{{exercise.explanation}}</view><view wx:if="{{exercise.bodyLabel}}" class="exercise-target">主要练{{exercise.bodyLabel}} · {{exercise.equipmentLabel}}</view>
     <view class="exercise-prescription"><view><text class="prescription-label">计划组数</text><text class="prescription-value">{{exercise.sets}} 组</text></view><view><text class="prescription-label">每组次数</text><text class="prescription-value">{{exercise.repsMin}}{{exercise.repsMax > exercise.repsMin ? '～' + exercise.repsMax : ''}} 次{{exercise.eachSide ? '/侧' : ''}}</text></view><view><text class="prescription-label">组间休息</text><text class="prescription-value">{{exercise.restSec}} 秒</text></view></view>
     <view wx:if="{{!draft}}" class="exercise-result"><text class="result-completed">已完成 <text class="result-number">{{exercise.doneSets}}</text> 组</text><text class="result-skipped">跳过 {{exercise.skippedSets}} 组</text></view>
     <view class="exercise-controls">
      <button size="mini" data-id="{{exercise.id}}" bindtap="movement">查看动作示范</button>
      <block wx:if="{{item.active && !item.finishedAt && !draft}}">
       <button wx:if="{{!exercise.handled}}" size="mini" class="set-complete" data-key="{{item.sourceKey}}" data-id="{{exercise.id}}" data-set="{{exercise.nextSet}}" bindtap="onSetTap" disabled="{{restTimer.visible}}">完成本组（第 {{exercise.nextSet}} 组）</button>
       <button wx:if="{{!exercise.handled}}" size="mini" data-key="{{item.sourceKey}}" data-id="{{exercise.id}}" data-set="{{exercise.nextSet}}" bindtap="skipSet" disabled="{{restTimer.visible}}">跳过本组</button>
       <button wx:if="{{!exercise.handled || exercise.skipped}}" size="mini" data-key="{{item.sourceKey}}" data-id="{{exercise.id}}" bindtap="toggle">{{exercise.skipped ? '恢复剩余组' : '跳过剩余组'}}</button>
       <text wx:if="{{exercise.handled}}">本动作已结束：完成 {{exercise.doneSets}} 组，跳过 {{exercise.skippedSets}} 组</text>
      </block>
     </view>
    </view>
   </view>
  </view>
  <button wx:if="{{item.active && !item.finishedAt}}" class="btn-primary session-start" data-key="{{item.sourceKey}}" bindtap="requestFinish">结束并核对组数</button>
  <view wx:if="{{!draft && !todayOnly}}" class="session-footer"><button size="mini" class="remove-btn" data-key="{{item.sourceKey}}" bindtap="remove">移除此日</button></view>
 </view>
 <button wx:if="{{draft}}" class="btn-primary save-btn" bindtap="save" loading="{{busy}}" disabled="{{busy}}">确认保存，进入训练日程</button>
 <view wx:if="{{restTimer.visible}}" class="rest-overlay"><view class="rest-card">
  <view class="rest-label">{{restTimer.label}}</view><view class="rest-count">{{restTimer.remain}}</view><view class="rest-unit">秒后开始下一组</view><button class="rest-skip-btn" bindtap="skipRest">跳过休息</button>
 </view></view>
</view>
