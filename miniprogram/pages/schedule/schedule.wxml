<view class="page">
 <view class="heading">{{draft ? '确认你的训练安排' : '我的训练日程'}}</view>
 <view class="hint">日程保存在当前账号的本机。完成标记不会自动计入运动消耗。</view>
 <view wx:if="{{error}}" class="notice error">{{error}}</view><view wx:if="{{success}}" class="notice">{{success}}</view>
 <view wx:if="{{draft}}" class="card"><view class="card-title">{{draft.title}}</view><view class="hint">{{draft.notes}}</view><picker mode="date" value="{{start}}" start="{{today}}" end="{{maxDate}}" bindchange="start"><view class="date-picker">开始日期：{{start}} · 修改</view></picker><view class="hint">也可逐日调整日期。已有安排不会被覆盖。</view></view>
 <view wx:else class="toolbar"><button size="mini" bindtap="past">{{showPast ? '仅看今天及以后' : '包含过去安排'}}</button><button size="mini" bindtap="calendar">日历查看</button></view>
 <view wx:if="{{!rows.length && !draft && !error}}" class="card"><view>还没有训练日程</view><view class="hint">在 AI 教练说明目标、经验、器械和每周训练次数，生成计划后点击“预览并保存”。</view><button bindtap="coach">让 AI 制定计划</button></view>
 <view wx:for="{{rows}}" wx:key="sourceKey" class="card session">
  <picker wx:if="{{draft}}" mode="date" value="{{item.date}}" start="{{today}}" end="{{maxDate}}" data-index="{{index}}" bindchange="day"><view class="date-picker">{{item.date}} · 调整日期</view></picker><view wx:else class="date-picker">{{item.date}} · {{item.doneCount}}/{{item.exercises.length}} 已完成</view>
  <view class="card-title">{{item.title}}</view>
  <view wx:for="{{item.exercises}}" wx:for-item="exercise" wx:key="id" class="exercise"><view class="exercise-name" data-id="{{exercise.id}}" bindtap="movement">{{exercise.name}} ›</view><view class="hint">{{exercise.sets}} 组 × {{exercise.repsMin}}～{{exercise.repsMax}} 次{{exercise.eachSide ? ' / 每侧' : ''}} · 组间休息 {{exercise.restSec}} 秒</view><button wx:if="{{!draft}}" class="done" size="mini" data-key="{{item.sourceKey}}" data-id="{{exercise.id}}" bindtap="toggle">{{exercise.done ? '✓ 已完成 · 取消' : '标记完成'}}</button></view>
  <button wx:if="{{!draft}}" size="mini" class="remove" data-key="{{item.sourceKey}}" bindtap="remove">移除当天安排</button>
 </view>
 <button wx:if="{{draft}}" class="btn-primary save" bindtap="save" loading="{{busy}}" disabled="{{busy}}">确认保存到训练日程</button>
</view>
