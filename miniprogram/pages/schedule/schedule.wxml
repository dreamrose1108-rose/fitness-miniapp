<view class="page schedule-page">
  <view class="heading">{{draft ? '确认你的训练安排' : '我的训练日程'}}</view>
  <view class="hint">保存在本机 · 完成标记不计入运动消耗</view>

  <view wx:if="{{error}}" class="notice error">{{error}}</view>
  <view wx:if="{{success}}" class="notice ok">{{success}}</view>

  <!-- AI 草稿确认 -->
  <block wx:if="{{draft}}">
    <view class="card draft-card">
      <view class="plan-icon">📋</view>
      <view class="card-title">{{draft.title}}</view>
      <view class="hint" wx:if="{{draft.notes}}">{{draft.notes}}</view>
      <picker mode="date" value="{{start}}" start="{{today}}" end="{{maxDate}}" bindchange="start">
        <view class="date-btn">📅 开始 {{start}} · 修改</view>
      </picker>
      <view class="hint">可逐日调整 · 已有安排不会被覆盖</view>
    </view>
  </block>

  <!-- 工具栏 -->
  <view wx:if="{{!draft && rows.length}}" class="toolbar">
    <button size="mini" bindtap="past">{{showPast ? '↑ 仅看今后' : '↓ 含过去'}}</button>
    <button size="mini" bindtap="calendar">📅 日历</button>
    <button size="mini" bindtap="coach">🤖 新计划</button>
  </view>

  <!-- 空状态 -->
  <view wx:if="{{!rows.length && !draft && !error}}" class="card empty-card">
    <view class="empty-icon">🏋️</view>
    <view class="empty-title">还没有训练日程</view>
    <view class="hint">告诉 AI 教练你的目标、经验、器械和每周训练次数</view>
    <button class="btn-primary empty-btn" bindtap="coach">让 AI 制定计划</button>
  </view>

  <!-- 日程卡片 -->
  <view wx:for="{{rows}}" wx:key="sourceKey"
        class="session-card {{item.isToday ? 'is-today' : ''}} {{item.isPast ? 'is-past' : ''}}">
    <view class="session-header">
      <picker wx:if="{{draft}}" mode="date" value="{{item.date}}" start="{{today}}" end="{{maxDate}}" data-index="{{index}}" bindchange="day">
        <view class="date-label {{item.isToday ? 'today' : ''}}">{{item.dateLabel}} ›</view>
      </picker>
      <view wx:else class="date-label {{item.isToday ? 'today' : ''}}">{{item.dateLabel}}</view>
      <view class="session-badge" wx:if="{{!draft && item.doneCount === item.exercises.length}}">✅ 完成</view>
      <view class="session-badge in-progress" wx:elif="{{!draft && item.doneCount > 0}}">进行中</view>
    </view>

    <view class="session-body" data-id="{{item.exercises[0].id}}" bindtap="movement">
      <view class="session-title">{{item.title}}</view>
      <view class="session-plan text-3" wx:if="{{item.planTitle && item.planTitle !== item.title}}">{{item.planTitle}}</view>
    </view>

    <!-- 进度条 -->
    <view class="progress-track" wx:if="{{!draft}}">
      <view class="progress-fill" style="width: {{item.exercises.length ? (item.doneCount / item.exercises.length) * 100 : 0}}%"></view>
    </view>
    <view class="progress-count text-3" wx:if="{{!draft}}">{{item.doneCount}} / {{item.exercises.length}} 动作</view>

    <!-- 动作列表 -->
    <view class="exercise-list">
      <view wx:for="{{item.exercises}}" wx:for-item="exercise" wx:for-index="eidx" wx:key="id"
            class="exercise-item {{exercise.done ? 'is-done' : ''}}">
        <view class="exercise-left" data-id="{{exercise.id}}" bindtap="movement">
          <view class="exercise-num {{exercise.done ? 'done' : ''}}">{{exercise.done ? '✓' : eidx + 1}}</view>
          <view class="exercise-info">
            <view class="exercise-name">{{exercise.name}}</view>
            <view class="exercise-detail">{{exercise.sets}}×{{exercise.repsMin}}{{exercise.repsMax > exercise.repsMin ? '～' + exercise.repsMax : ''}}{{exercise.eachSide ? '/侧' : ''}} · 休{{exercise.restSec}}s</view>
          </view>
        </view>
        <button wx:if="{{!draft}}" class="done-btn {{exercise.done ? 'is-done' : ''}}" size="mini"
                data-key="{{item.sourceKey}}" data-id="{{exercise.id}}" bindtap="toggle">
          {{exercise.done ? '取消' : '完成'}}
        </button>
      </view>
    </view>

    <view class="session-footer" wx:if="{{!draft}}">
      <button size="mini" class="remove-btn" data-key="{{item.sourceKey}}" bindtap="remove">移除此日</button>
    </view>
  </view>

  <button wx:if="{{draft}}" class="btn-primary save-btn" bindtap="save" loading="{{busy}}" disabled="{{busy}}">
    确认保存到训练日程
  </button>
</view>
