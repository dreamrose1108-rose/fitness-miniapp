<view class="page schedule-page">
 <view class="heading">{{draft ? '确认日期，再开始训练' : '我的训练日程'}}</view>
 <view class="hint">组数与完成进度保存在本机 · 打卡不自动计入热量</view>
 <view wx:if="{{error}}" class="notice error">{{error}}</view>
 <view wx:if="{{success}}" class="notice ok">{{success}}</view>
 <view wx:if="{{draft}}" class="card draft-card">
  <view class="card-title">{{draft.title}}</view><view class="hint">{{draft.notes}}</view>
  <picker mode="date" value="{{start}}" start="{{today}}" end="{{maxDate}}" bindchange="start"><view class="date-btn">开始日期 {{start}} · 修改</view></picker>
  <view class="hint">可逐日调整，已有训练不会被覆盖。保存后才能开始训练。</view>
 </view>
 <view wx:if="{{!draft}}" class="toolbar">
  <button size="mini" bindtap="past">{{showPast ? '仅看今后' : '查看历史'}}</button><button size="mini" bindtap="calendar">日历</button><button size="mini" bindtap="coach">AI 新计划</button><button size="mini" bindtap="templates">选模板</button>
 </view>
 <view wx:if="{{!rows.length && !draft && !error}}" class="card empty-card">
  <view class="empty-title">还没有训练日程</view><view class="hint">可以让 AI 按你的条件生成，也可以直接选择训练模板。</view>
  <button class="btn-primary empty-btn" bindtap="coach">让 AI 制定计划</button><button bindtap="templates">选择训练模板</button>
 </view>
 <view wx:for="{{rows}}" wx:key="sourceKey" class="session-card {{item.isToday ? 'is-today' : ''}}">
  <view class="session-header">
   <picker wx:if="{{draft}}" mode="date" value="{{item.date}}" start="{{today}}" end="{{maxDate}}" data-index="{{index}}" bindchange="day"><view class="date-label">{{item.dateLabel}} · 改期</view></picker>
   <view wx:else class="date-label">{{item.dateLabel}}</view>
   <view class="session-badge">{{item.finishedAt ? '已结束' : item.startedAt ? '进行中' : '未开始'}}</view>
  </view>
  <view class="session-body"><view class="session-title">{{item.title}}</view><view class="hint">{{item.planTitle}}</view></view>
  <block wx:if="{{!draft}}">
   <view class="progress-count">完成 {{item.doneCount}} / {{item.exercises.length}} 个动作<text wx:if="{{item.skippedCount}}"> · 跳过 {{item.skippedCount}} 个</text></view>
   <button wx:if="{{item.isToday && !item.finishedAt && !item.active}}" class="btn-primary session-start" data-key="{{item.sourceKey}}" bindtap="begin">{{item.startedAt ? '继续训练' : '开始训练'}}</button>
   <view wx:if="{{!item.isToday && !item.finishedAt}}" class="hint session-start">{{item.isPast ? '历史安排，仅供查看' : '尚未到训练日期，可先查看动作演示'}}</view>
  </block>
  <view class="exercise-list">
   <view wx:for="{{item.exercises}}" wx:for-item="exercise" wx:for-index="eidx" wx:key="id" class="exercise-item {{exercise.done ? 'is-done' : ''}}">
    <view class="exercise-info">
     <view class="exercise-name">{{eidx + 1}}. {{exercise.name}}</view>
     <view class="exercise-detail">{{exercise.sets}} 组 × {{exercise.repsMin}}{{exercise.repsMax > exercise.repsMin ? '～' + exercise.repsMax : ''}} 次{{exercise.eachSide ? '/侧' : ''}} · 休息 {{exercise.restSec}} 秒</view>
     <view wx:if="{{!draft}}" class="exercise-detail">{{exercise.skipped ? '本次跳过' : '已完成 ' + exercise.doneSets + '/' + exercise.sets + ' 组'}}</view>
     <view class="exercise-controls">
      <button size="mini" data-id="{{exercise.id}}" bindtap="movement">看演示</button>
      <block wx:if="{{item.active && !item.finishedAt && !draft}}">
       <button wx:if="{{!exercise.done && !exercise.skipped}}" size="mini" class="set-complete" data-key="{{item.sourceKey}}" data-id="{{exercise.id}}" data-set="{{exercise.nextSet}}" bindtap="onSetTap" disabled="{{restTimer.visible}}">完成第 {{exercise.nextSet}} 组</button>
       <button wx:if="{{!exercise.done}}" size="mini" data-key="{{item.sourceKey}}" data-id="{{exercise.id}}" bindtap="toggle">{{exercise.skipped ? '恢复此动作' : '跳过此动作'}}</button>
       <text wx:if="{{exercise.done}}">已完成 ✓</text>
      </block>
     </view>
    </view>
   </view>
  </view>
  <button wx:if="{{item.active && !item.finishedAt}}" class="btn-primary session-start" data-key="{{item.sourceKey}}" bindtap="finish" disabled="{{!item.ready}}">结束本次训练</button>
  <view wx:if="{{!draft}}" class="session-footer"><button size="mini" class="remove-btn" data-key="{{item.sourceKey}}" bindtap="remove">移除此日</button></view>
 </view>
 <button wx:if="{{draft}}" class="btn-primary save-btn" bindtap="save" loading="{{busy}}" disabled="{{busy}}">确认保存，进入训练日程</button>
 <view wx:if="{{restTimer.visible}}" class="rest-overlay"><view class="rest-card">
  <view class="rest-label">{{restTimer.label}}</view><view class="rest-count">{{restTimer.remain}}</view><view class="rest-unit">秒后开始下一组</view><button class="rest-skip-btn" bindtap="skipRest">跳过休息</button>
 </view></view>
</view>
