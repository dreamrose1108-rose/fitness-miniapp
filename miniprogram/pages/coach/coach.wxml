<page-meta page-style="{{appThemeStyle}}" />
<view class="page coach-page">
  <!-- 今日速览（可收起） -->
  <view class="today-snapshot {{snapshotCollapsed ? 'collapsed' : ''}}">
    <view class="snapshot-header" bindtap="toggleSnapshot">
      <text class="snapshot-title">📊 今日</text>
      <text class="snapshot-toggle">{{snapshotCollapsed ? '展开' : '收起'}}</text>
    </view>
    <view class="snapshot-body" wx:if="{{!snapshotCollapsed}}">
      <view class="snap-item">
        <text class="snap-val">{{todaySummary.intake || 0}}</text>
        <text class="snap-label">摄入 kcal</text>
      </view>
      <view class="snap-divider"></view>
      <view class="snap-item">
        <text class="snap-val protein">{{todaySummary.proteinG || 0}}g</text>
        <text class="snap-label">蛋白质</text>
      </view>
      <view class="snap-divider"></view>
      <view class="snap-item">
        <text class="snap-val">{{todaySummary.burned || 0}}</text>
        <text class="snap-label">消耗 kcal</text>
      </view>
      <view class="snap-divider"></view>
      <view class="snap-item">
        <text class="snap-val {{todayTraining ? 'ok' : ''}}">{{todayTraining ? '🏋️' : '—'}}</text>
        <text class="snap-label">训练</text>
      </view>
    </view>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    class="chat-list"
    scroll-y
    scroll-into-view="{{scrollToId}}"
    enhanced
    show-scrollbar="{{false}}"
  >
    <view class="chat-content">
    <view class="welcome" wx:if="{{messages.length === 0}}">
      <view class="welcome-avatar"><image class="avatar-img" src="/images/coach-cat.png" mode="aspectFill" /></view>
      <text class="welcome-title">喵～我是你的猫咪教练</text>
      <text class="welcome-desc">我能查你的真实数据、联网搜资料、制定训练计划</text>
      <view class="quick-grid">
        <view class="quick-chip" data-q="我今天吃了多少热量？" bindtap="onQuickQuestion">
          <text class="quick-icon">🍚</text>
          <text class="quick-text">今天吃了多少</text>
        </view>
        <view class="quick-chip" data-q="我今天蛋白质吃够了吗？" bindtap="onQuickQuestion">
          <text class="quick-icon">🥚</text>
          <text class="quick-text">蛋白质够吗</text>
        </view>
        <view class="quick-chip" data-q="帮我制定一个训练计划" bindtap="onQuickQuestion">
          <text class="quick-icon">🏋️</text>
          <text class="quick-text">制定训练计划</text>
        </view>
        <view class="quick-chip" data-q="我最近的体重趋势怎么样？" bindtap="onQuickQuestion">
          <text class="quick-icon">⚖️</text>
          <text class="quick-text">体重趋势</text>
        </view>
        <view class="quick-chip" data-q="推荐一个低卡晚餐" bindtap="onQuickQuestion">
          <text class="quick-icon">🥗</text>
          <text class="quick-text">推荐低卡晚餐</text>
        </view>
        <view class="quick-chip" data-q="搜索最新的减脂研究" bindtap="onQuickQuestion">
          <text class="quick-icon">🔍</text>
          <text class="quick-text">联网搜资料</text>
        </view>
      </view>
    </view>

    <view
      wx:for="{{messages}}" wx:key="id"
      id="msg-{{item.id}}"
      class="msg-row {{item.role === 'user' ? 'right' : 'left'}}"
    >
      <view class="msg-avatar avatar-cat" wx:if="{{item.role === 'assistant'}}"><image class="avatar-img" src="/images/coach-cat.png" mode="aspectFill" /></view>
      <view class="bubble {{item.role === 'user' ? 'bubble-user' : 'bubble-ai'}}">
        <text selectable>{{item.content}}</text>
        <view wx:if="{{item.searchLabel}}" class="search-label">{{item.searchLabel}}</view>
        <view wx:for="{{item.sources}}" wx:for-item="source" wx:for-index="sourceIndex" wx:key="url" class="search-source" data-message="{{item.id}}" data-index="{{sourceIndex}}" bindtap="copySource">[{{source.id}}] {{source.title}}<text class="source-meta">{{source.site}} {{source.date}}</text></view>
        <view wx:if="{{item.trainingPlan}}" class="plan-draft"><view>{{item.trainingPlan.title}}</view><text>{{item.trainingPlan.days.length}} 个训练日 · 尚未写入日程</text><button size="mini" data-message="{{item.id}}" bindtap="previewPlan">预览并保存到训练日程</button></view>
        <text wx:if="{{typing && index === messages.length - 1 && item.role === 'assistant'}}" class="cursor"></text>
      </view>
      <view class="msg-avatar avatar-user" wx:if="{{item.role === 'user'}}">我</view>
    </view>

    <view wx:if="{{sendError}}" class="send-error">{{sendError}} · 问题已保留，可点击发送重试</view>

    <!-- 思考中（猫爪走路） -->
    <view class="msg-row left" wx:if="{{thinking}}">
      <view class="msg-avatar avatar-cat"><image class="avatar-img" src="/images/coach-cat.png" mode="aspectFill" /></view>
      <view class="bubble bubble-ai typing"><text class="paw-walk">🐾 怪喵思考中</text></view>
    </view>
    </view>
  </scroll-view>

  <!-- 输入栏（搜索按钮合并到左侧） -->
  <view class="input-bar safe-bottom">
    <view class="search-icon {{webSearch ? 'on' : ''}}" bindtap="toggleSearch">{{webSearch ? '🔍' : '🔎'}}</view>
    <input
      class="chat-input"
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="onSend"
      confirm-type="send"
      placeholder="{{webSearch ? '联网搜索中…' : '想问喵什么...'}}"
      maxlength="500"
      disabled="{{thinking || typing}}"
    />
    <button class="send-btn" style="width:136rpx;height:76rpx;padding:0;margin:0;" bindtap="onSend" disabled="{{thinking || typing || !inputText}}">喵送</button>
  </view>
</view>
