page { height: 100%; overflow: hidden; }
.coach-page {
  padding: 0; height: 100vh; min-height: 0; overflow: hidden;
  display: flex; flex-direction: column;
  background: var(--color-bg);
}

/* ===== 免责横幅（回归全局浅绿）===== */
.disclaimer {
  background: var(--color-primary-light); color: var(--color-primary);
  font-size: 22rpx; text-align: center; padding: 14rpx 24rpx;
}

.disclaimer, .input-bar { flex-shrink: 0; }
.chat-list { flex: 1; height: 0; min-height: 0; width: 100%; box-sizing: border-box; }
.chat-content { padding: 24rpx; }

/* ===== 欢迎态 ===== */
.welcome { display: flex; flex-direction: column; align-items: center; padding-top: 100rpx; }
.welcome-avatar {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: var(--color-primary-light);
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx; margin-bottom: 28rpx;
  position: relative; overflow: hidden;
}
.avatar-img { width: 100%; height: 100%; border-radius: 50%; display: block; }
.welcome-avatar::before, .welcome-avatar::after {
  content: ''; position: absolute; top: -12rpx; width: 0; height: 0;
  border-left: 13rpx solid transparent; border-right: 13rpx solid transparent;
  border-bottom: 22rpx solid var(--color-primary-light);
}
.welcome-avatar::before { left: 16rpx; transform: rotate(-18deg); }
.welcome-avatar::after { right: 16rpx; transform: rotate(18deg); }
.welcome-title { font-size: 34rpx; font-weight: 600; }
.welcome-desc { font-size: 24rpx; color: var(--color-text-3); margin-top: 12rpx; }
.quick-questions { margin-top: 48rpx; width: 100%; }
.quick-q {
  background: var(--color-card); border: 1rpx solid var(--color-border);
  border-radius: 32rpx;
  padding: 20rpx 28rpx; font-size: 26rpx; color: var(--color-text-2);
  margin-bottom: 16rpx; text-align: center;
}
.quick-q:active { background: var(--color-primary-light); }

/* ===== 消息气泡 ===== */
.msg-row { display: flex; align-items: flex-start; margin-bottom: 28rpx; }
.msg-row.right { justify-content: flex-end; }

/* 猫咪头像（浅绿底，保留小猫耳） */
.avatar-cat {
  width: 64rpx; height: 64rpx; border-radius: 50%;
  background: var(--color-primary-light);
  display: flex; align-items: center; justify-content: center;
  font-size: 32rpx; flex-shrink: 0;
  position: relative; overflow: hidden;
}
.avatar-cat::before, .avatar-cat::after {
  content: ''; position: absolute; top: -7rpx; width: 0; height: 0;
  border-left: 7rpx solid transparent; border-right: 7rpx solid transparent;
  border-bottom: 12rpx solid var(--color-primary-light);
}
.avatar-cat::before { left: 6rpx; transform: rotate(-16deg); }
.avatar-cat::after { right: 6rpx; transform: rotate(16deg); }

/* 用户头像 */
.avatar-user {
  width: 64rpx; height: 64rpx; border-radius: 50%; flex-shrink: 0;
  background: var(--color-primary-light); color: var(--color-primary);
  display: flex; align-items: center; justify-content: center; font-size: 26rpx;
}

.bubble {
  max-width: 76%; padding: 20rpx 26rpx; font-size: 28rpx; line-height: 1.6;
  word-break: break-all;
}

/* AI 气泡：白卡片（同全局），保留轻微猫耳 */
.bubble-ai {
  background: var(--color-card); margin-left: 16rpx;
  border-radius: 20rpx 20rpx 20rpx 4rpx;
  color: var(--color-text);
}
.bubble-user {
  background: var(--color-primary); color: #fff; margin-right: 16rpx;
  border-radius: 20rpx 20rpx 4rpx 20rpx;
}
.typing { color: var(--color-text-3); }

/* 思考中猫爪微动画 */
.paw-walk::after {
  content: '🐾';
  display: inline-block;
  animation: pawStep 1.2s ease-in-out infinite;
}
@keyframes pawStep {
  0%, 100% { transform: translateX(0); opacity: 0.4; }
  50% { transform: translateX(10rpx); opacity: 1; }
}

/* ===== 输入栏（回归全局样式）===== */
.input-bar {
  display: flex; align-items: center; padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background: var(--color-card); border-top: 1rpx solid var(--color-border);
}
.chat-input {
  flex: 1; height: 76rpx; line-height: 76rpx;
  background: var(--color-bg); border-radius: 38rpx;
  padding: 0 30rpx; font-size: 28rpx; margin-right: 16rpx;
  box-sizing: border-box; min-height: 76rpx; min-width: 0;
}

/* 打字机光标 */
.cursor {
  display: inline-block; width: 4rpx; height: 32rpx;
  background: var(--color-primary); margin-left: 8rpx;
  vertical-align: middle;
  animation: blink 0.8s step-end infinite;
}
@keyframes blink { 50% { opacity: 0; } }

.send-btn {
  width: 136rpx; height: 76rpx; padding: 0; margin: 0;
  display: flex; align-items: center; justify-content: center;
  background: var(--color-primary); color: #fff;
  font-size: 28rpx; font-weight: 500; line-height: 1;
  border-radius: 38rpx; box-sizing: border-box;
  min-width: 0; flex-shrink: 0;
}
.send-btn::after { border: none; }
.send-btn[disabled] { opacity: 0.5; }

.send-error {
  padding: 20rpx; margin: 16rpx 0; color: var(--color-danger);
  background: #fdf0ee; border-radius: 12rpx; font-size: 24rpx;
}

.search-options{display:flex;align-items:center;gap:20rpx;padding:12rpx 24rpx;background:var(--color-card);flex-shrink:0;color:var(--color-text-2);font-size:22rpx;}
.search-toggle{margin:0;font-size:24rpx;border-radius:24rpx;line-height:2.2;color:var(--color-primary);background:var(--color-primary-light);}
.search-toggle.selected{color:white;background:var(--color-primary);}
.search-label{font-size:22rpx;color:var(--color-text-2);border-top:1rpx solid var(--color-border);margin-top:20rpx;padding-top:16rpx;}
.search-source{font-size:24rpx;line-height:1.6;color:var(--color-primary);margin-top:14rpx;overflow-wrap:break-word;}
.source-meta{display:block;color:var(--color-text-2);font-size:21rpx;}

.plan-draft{margin-top:24rpx;padding:20rpx;background:var(--color-primary-light);border-radius:16rpx}.plan-draft text{display:block;font-size:23rpx;margin:12rpx 0;color:var(--color-text-2)}.plan-draft button{font-size:24rpx;color:white;background:var(--color-primary);margin:10rpx 0 0}

/* ===== 今日速览 ===== */
.today-snapshot {
  background: var(--color-card); border-bottom: 1rpx solid var(--color-border);
  flex-shrink: 0;
}
.snapshot-header {
  display: flex; justify-content: space-between; align-items: center;
  padding: 16rpx 24rpx;
}
.snapshot-title { font-size: 26rpx; font-weight: 600; color: var(--color-text-2); }
.snapshot-toggle { font-size: 22rpx; color: var(--color-text-3); }
.snapshot-body {
  display: flex; align-items: center; justify-content: space-around;
  padding: 0 24rpx 20rpx;
}
.snap-item { display: flex; flex-direction: column; align-items: center; }
.snap-val { font-size: 34rpx; font-weight: 700; color: var(--color-text); }
.snap-val.protein { color: var(--color-primary); }
.snap-val.ok { color: var(--color-primary); }
.snap-label { font-size: 20rpx; color: var(--color-text-3); margin-top: 4rpx; }
.snap-divider { width: 1rpx; height: 40rpx; background: var(--color-border); }

/* ===== 快捷提问网格 ===== */
.quick-grid {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 16rpx;
  width: 100%; margin-top: 32rpx; padding: 0 16rpx; box-sizing: border-box;
}
.quick-chip {
  display: flex; flex-direction: column; align-items: center; gap: 6rpx;
  background: var(--color-card); border: 1rpx solid var(--color-border);
  border-radius: 16rpx; padding: 20rpx 12rpx;
}
.quick-chip:active { background: var(--color-primary-light); border-color: var(--color-primary); }
.quick-icon { font-size: 36rpx; }
.quick-text { font-size: 22rpx; color: var(--color-text-2); text-align: center; }

/* 搜索图标（合并到输入栏） */
.search-icon {
  width: 64rpx; height: 64rpx; flex-shrink: 0;
  display: flex; align-items: center; justify-content: center;
  font-size: 36rpx; border-radius: 50%; margin-right: 12rpx;
  background: var(--color-bg); transition: all .2s;
}
.search-icon.on {
  background: var(--color-primary-light);
  box-shadow: 0 0 0 4rpx var(--color-primary-light);
}
.coach-meal-card{margin-top:24rpx;padding:24rpx;border:1rpx solid var(--color-border);border-radius:20rpx;background:var(--color-bg);color:var(--color-text);}.coach-meal-title{font-weight:600;font-size:28rpx;}.coach-meal-tip{display:block;font-size:22rpx;line-height:1.6;color:var(--color-text-2);margin-top:12rpx;}.coach-meal-item{margin-top:20rpx;font-size:24rpx;line-height:1.6;}.coach-meal-choice{padding:14rpx;background:var(--color-card);border:1rpx solid var(--color-border);border-radius:12rpx;white-space:normal;word-break:break-all;}.coach-meal-controls{display:flex;gap:16rpx;flex-wrap:wrap;margin:20rpx 0;}.coach-meal-controls picker{padding:12rpx;background:var(--color-card);border-radius:12rpx;font-size:24rpx;}.coach-meal-card button{width:100%;margin:0;background:var(--color-primary);color:#fff;line-height:1.6;padding:16rpx 8rpx;white-space:normal;}.coach-meal-card button[disabled]{background:var(--color-primary-light);color:var(--color-text-2);}
.coach-meal-choice{word-break:normal;overflow-wrap:break-word;}
