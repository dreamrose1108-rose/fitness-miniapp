.meal-photo{width:100%;height:360rpx;border-radius:20rpx;background:var(--color-card)}.heading{font-size:36rpx;font-weight:600;margin:24rpx 0}.hint{font-size:24rpx;line-height:1.8;color:var(--color-text-2);margin:14rpx 0}.error{padding:24rpx;background:#fdf0ee;color:var(--color-danger);border-radius:16rpx;margin:20rpx 0}.food-heading{display:flex;align-items:center;gap:12rpx}.food-name{flex:1;min-width:0;height:64rpx;line-height:64rpx;padding:0;font-size:30rpx;font-weight:600}.remove{margin:0;font-size:22rpx;height:64rpx;line-height:64rpx;flex-shrink:0;display:flex;align-items:center;justify-content:center}.fields{display:grid;grid-template-columns:1fr 1fr;gap:16rpx;margin-top:24rpx}.fields.macros{grid-template-columns:1fr 1fr 1fr}.fields text{font-size:22rpx;color:var(--color-text-2)}.fields input{height:72rpx;line-height:72rpx;min-width:0;width:100%;background:var(--color-bg);border-radius:10rpx;margin-top:10rpx;padding:0 16rpx;box-sizing:border-box;font-size:28rpx}.total{font-size:36rpx;font-weight:600;color:var(--color-primary)}.actions{display:flex;gap:16rpx;margin:28rpx 0 50rpx}.actions button{margin:0;font-size:24rpx}

.fields > view{min-width:0;}
