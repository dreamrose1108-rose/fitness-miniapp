.sum-card .sum-label { display: block; font-size: 24rpx; color: var(--color-text-3); }
.sum-num { display: block; font-size: 60rpx; font-weight: 700; line-height: 1.2; }
.sum-unit { font-size: 24rpx; font-weight: 400; color: var(--color-text-3); }
.sum-right { text-align: right; font-size: 24rpx; }
.remain { display: block; color: var(--color-primary); font-weight: 600; margin-top: 8rpx; font-size: 28rpx; }
.progress { height: 12rpx; background: var(--color-bg); border-radius: 8rpx; margin-top: 20rpx; overflow: hidden; }
.progress-bar { height: 100%; background: var(--color-primary); border-radius: 8rpx; transition: width 0.3s; }

.meal-tabs { display: flex; background: var(--color-card); border-radius: var(--radius); padding: 8rpx; margin-bottom: 20rpx; }
.meal-tab {
  flex: 1; text-align: center; padding: 18rpx 0; font-size: 26rpx;
  color: var(--color-text-2); border-radius: 12rpx;
}
.meal-tab.active { background: var(--color-primary-light); color: var(--color-primary); font-weight: 600; }

.add-btn { margin-bottom: 0; }
.add-row { display: flex; gap: 16rpx; margin-bottom: 24rpx; }
.add-row .add-btn { flex: 1; margin-bottom: 0; }
.photo-btn {
  background: var(--color-card); color: var(--color-text); border: 2rpx solid var(--color-border);
  border-radius: 44rpx; font-size: 28rpx; padding: 16rpx 28rpx; margin: 0; line-height: 1.6;
}
.photo-btn::after { border: none; }

.pending-photo-tip {
  background: var(--color-primary-light); color: var(--color-primary);
  border-radius: 12rpx; font-size: 24rpx; padding: 16rpx 24rpx; margin-bottom: 24rpx;
  display: flex; align-items: center; justify-content: space-between;
}
.pp-cancel { color: var(--color-text-3); padding: 0 8rpx; }

.food-thumb {
  width: 88rpx; height: 88rpx; border-radius: 12rpx; overflow: hidden;
  margin-right: 20rpx; flex-shrink: 0; background: var(--color-bg);
}
.thumb-img { width: 100%; height: 100%; }

.food-row {
  display: flex; align-items: center; padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.food-row:last-child { border-bottom: none; }
.food-info { flex: 1; }
.food-name { display: block; font-size: 28rpx; }
.food-amount { display: block; font-size: 22rpx; margin-top: 6rpx; }
.food-kcal { font-size: 28rpx; font-weight: 600; color: var(--color-primary); margin: 0 20rpx; }
.del { color: var(--color-text-3); font-size: 26rpx; padding: 10rpx; }

.empty { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0; gap: 16rpx; font-size: 24rpx; }
.empty-icon { font-size: 64rpx; }

/* 弹层 */
.mask { position: fixed; inset: 0; background: rgba(0,0,0,0.45); z-index: 100; }
.picker {
  position: fixed; left: 0; right: 0; bottom: 0; height: 75vh;
  background: var(--color-card); border-radius: 28rpx 28rpx 0 0; z-index: 101;
  transform: translateY(110%); transition: transform 0.28s ease;
  display: flex; flex-direction: column; padding: 0 24rpx 24rpx;
}
.picker.show { transform: translateY(0); }
.picker-head { display: flex; justify-content: space-between; align-items: center; padding: 28rpx 0 16rpx; }
.picker-title { font-size: 32rpx; font-weight: 600; }
.picker-close { font-size: 26rpx; color: var(--color-text-3); }
.cat-bar { white-space: nowrap; padding: 8rpx 0 16rpx; }
.cat-item {
  display: inline-block; padding: 12rpx 28rpx; margin-right: 16rpx;
  font-size: 25rpx; color: var(--color-text-2); background: var(--color-bg); border-radius: 32rpx;
}
.cat-item.active { background: var(--color-primary); color: #fff; }

.food-list { flex: 1; }
.picker-food {
  display: flex; justify-content: space-between; align-items: center;
  padding: 22rpx 0; border-bottom: 1rpx solid var(--color-border);
}
.pf-name { display: block; font-size: 28rpx; }
.pf-cat { display: block; font-size: 22rpx; margin-top: 6rpx; }
.pf-kcal { color: var(--color-primary); font-weight: 600; font-size: 26rpx; }
.pf-name-row { display: flex; align-items: center; }
.pf-badge {
  font-size: 18rpx; color: var(--color-primary); background: var(--color-primary-light);
  border-radius: 8rpx; padding: 2rpx 10rpx; margin-left: 12rpx;
}

.search-row { display: flex; align-items: center; margin-bottom: 12rpx; }

.add-custom-btn {
  margin-left: 16rpx; font-size: 25rpx; color: var(--color-primary);
  background: var(--color-primary-light); border-radius: 32rpx; padding: 14rpx 24rpx; flex-shrink: 0;
}

.tip { text-align: center; font-size: 22rpx; color: var(--color-text-3); padding: 16rpx 0 40rpx; }

/* 自定义食物表单 */
.custom-form {
  position: fixed; left: 50%; top: 50%; transform: translate(-50%, -50%);
  width: 620rpx; background: var(--color-card); border-radius: 24rpx; z-index: 102;
  padding: 40rpx 36rpx 32rpx;
}
.cf-title { font-size: 32rpx; font-weight: 600; text-align: center; margin-bottom: 32rpx; }
.cf-item {
  display: flex; align-items: center; padding: 20rpx 0;
  border-bottom: 1rpx solid var(--color-border);
}
.cf-label { width: 150rpx; font-size: 27rpx; color: var(--color-text-2); flex-shrink: 0; }
.cf-input { flex: 1; min-width: 0; height: 72rpx; line-height: 72rpx; padding: 0; font-size: 28rpx; text-align: right; }
.cf-picker { flex: 1; text-align: right; font-size: 28rpx; color: var(--color-text); }
.cf-tip { font-size: 22rpx; margin-top: 20rpx; line-height: 1.6; }
.cf-btns { display: flex; margin-top: 32rpx; gap: 20rpx; }
.cf-cancel {
  flex: 1; background: var(--color-bg); color: var(--color-text-2);
  font-size: 28rpx; border-radius: 44rpx; padding: 14rpx 0; margin: 0;
}
.cf-cancel::after, .cf-ok::after { border: none; }
.cf-ok {
  flex: 1; background: var(--color-primary); color: #fff;
  font-size: 28rpx; border-radius: 44rpx; padding: 14rpx 0; margin: 0;
}
.cf-ok[disabled] { opacity: 0.5; }

.photo-ai-note{display:block;font-size:22rpx;line-height:1.6;color:var(--color-text-2);margin-top:12rpx;}
.disclosure{margin:-8rpx 0 24rpx;}
.photo-processing-canvas{position:fixed;left:-9999px;top:0;width:1px;height:1px;pointer-events:none;}

/* AI 在线查询 */
.ai-search-btn {
  background: var(--color-primary) !important; color: #fff !important;
  font-size: 26rpx; border-radius: 20rpx; margin: 16rpx 0 0; padding: 10rpx 32rpx;
}
.ai-result { padding: 0 20rpx 16rpx; }
.ai-result-card {
  background: var(--color-primary-light); border-radius: 16rpx; padding: 24rpx;
}
.ai-result-title { font-size: 26rpx; color: var(--color-primary); font-weight: 600; margin-bottom: 12rpx; }
.ai-result-body { display: flex; align-items: baseline; gap: 12rpx; margin-bottom: 8rpx; }
.ai-result-name { font-size: 30rpx; font-weight: 600; }
.ai-result-kcal { font-size: 36rpx; color: var(--color-primary); font-weight: 700; }
.ai-result-unit { font-size: 22rpx; color: var(--color-text-3); }
.ai-result-macros { font-size: 24rpx; color: var(--color-text-2); margin-bottom: 16rpx; }
.ai-result-actions { display: flex; gap: 16rpx; }
.save-ai-btn { background: var(--color-primary) !important; color: #fff !important; font-size: 24rpx; border-radius: 20rpx; }
.ai-result-note { font-size: 20rpx; margin-top: 12rpx; }

/* 日期导航 */
.date-nav { display: flex; align-items: center; gap: 16rpx; margin-bottom: 16rpx; }
.date-nav-btn { background: var(--color-card); border: 1rpx solid var(--color-border); border-radius: 24rpx; padding: 12rpx 28rpx; font-size: 28rpx; color: var(--color-text); }
.date-nav-today { color: var(--color-primary); font-size: 26rpx; }

/* Native input needs an explicit content height; vertical padding clips text. */
.picker-head,.cat-bar,.search-row{flex-shrink:0;}
.search-row{gap:16rpx;align-items:center;}
.search{flex:1;min-width:0;height:76rpx;min-height:76rpx;line-height:76rpx;padding:0 24rpx;margin:0;background:var(--color-bg);border-radius:18rpx;font-size:26rpx;color:var(--color-text);}
.search-placeholder{color:var(--color-text-2);}
.add-custom-btn{margin-left:0;height:76rpx;display:flex;align-items:center;justify-content:center;padding:0 24rpx;}
.food-list{height:0;min-height:0;flex:1;}
.picker{padding-bottom:calc(24rpx + env(safe-area-inset-bottom));}

.add-row{align-items:stretch;flex-wrap:wrap;}.add-row .add-btn,.add-row .photo-btn{flex:1;min-width:0;margin:0;display:flex;align-items:center;justify-content:center;line-height:1.5;padding:18rpx 12rpx;font-size:28rpx;}

.sum-right > text{display:block;line-height:1.6;}.sum-card .flex-between{gap:16rpx;flex-wrap:wrap;}

.food-catalog-info{display:flex;justify-content:space-between;gap:12rpx;flex-wrap:wrap;font-size:22rpx;color:var(--color-text-2);padding:12rpx 0;flex-shrink:0;}.pf-source{display:block;font-size:20rpx;line-height:1.5;color:var(--color-text-2);margin-top:6rpx;}.picker-food>view{flex:1;min-width:0;}.pf-kcal{flex-shrink:0;margin-left:16rpx;}

.pf-detail{display:block;font-size:22rpx;line-height:1.6;color:var(--color-text-2);margin-top:8rpx;}
.portion-mask{z-index:104;}.portion-panel{position:fixed;z-index:105;left:24rpx;right:24rpx;top:50%;transform:translateY(-50%);max-height:80vh;overflow-y:auto;background:var(--color-card);color:var(--color-text);border-radius:24rpx;padding:32rpx;box-sizing:border-box;}.portion-units{display:flex;flex-wrap:wrap;gap:12rpx;margin:24rpx 0;}.portion-unit{margin:0;padding:12rpx 24rpx;font-size:26rpx;line-height:1.6;background:var(--color-bg);color:var(--color-text);border-radius:32rpx;}.portion-unit::after{border:0;}.portion-unit.selected{background:var(--color-primary);color:#fff;}.portion-input-row{display:flex;align-items:center;gap:20rpx;background:var(--color-bg);padding:0 24rpx;border-radius:16rpx;}.portion-input-row input{flex:1;min-width:0;height:88rpx;line-height:88rpx;font-size:36rpx;color:var(--color-text);padding:0;}.portion-input-row text{flex-shrink:0;font-size:26rpx;}.portion-help{display:block;font-size:24rpx;line-height:1.7;color:var(--color-text-2);margin-top:16rpx;}.portion-summary{padding:24rpx 0;font-size:32rpx;font-weight:600;color:var(--color-primary);}.portion-source{display:block;margin-bottom:24rpx;font-size:22rpx;color:var(--color-primary);}.portion-panel .cf-ok{width:100%;}
.portion-units .portion-unit{width:calc(50% - 6rpx);flex:0 0 calc(50% - 6rpx);min-width:0;margin:0;box-sizing:border-box;}
.portion-panel .picker-close{flex-shrink:0;white-space:nowrap;}.portion-panel .picker-title{flex:1;min-width:0;margin-right:20rpx;}
