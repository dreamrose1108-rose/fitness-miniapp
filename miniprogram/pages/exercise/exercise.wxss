.sum-label { display: block; font-size: 24rpx; color: var(--color-text-3); }
.sum-num { display: block; font-size: 60rpx; font-weight: 700; line-height: 1.2; color: var(--color-primary); }
.sum-unit { font-size: 24rpx; font-weight: 400; color: var(--color-text-3); }
.sum-right { text-align: right; font-size: 24rpx; }
.count { display: block; font-weight: 600; font-size: 32rpx; margin-top: 8rpx; }

.ex-grid { display: flex; flex-wrap: wrap; }
.ex-item {
  width: 25%; text-align: center; padding: 20rpx 4rpx;
  border-radius: 16rpx; border: 2rpx solid transparent;
}
.ex-item.active { background: var(--color-primary-light); border-color: var(--color-primary); }
.ex-icon { display: block; font-size: 48rpx; }
.ex-name { display: block; font-size: 25rpx; margin-top: 10rpx; }
.ex-met { display: block; font-size: 20rpx; margin-top: 4rpx; }

.input-row { padding: 8rpx 0 20rpx; }
.duration-input { display: flex; align-items: center; font-size: 26rpx; color: var(--color-text-2); }
.duration-input input {
  width: 140rpx; text-align: right; font-size: 32rpx;
  border-bottom: 2rpx solid var(--color-border); margin-right: 12rpx; padding: 8rpx;
}
.estimate { padding: 16rpx 0; border-top: 1rpx solid var(--color-border); }
.estimate-num { color: var(--color-primary); font-weight: 600; font-size: 30rpx; }
.submit-btn { margin-top: 20rpx; }

.ex-row { display: flex; align-items: center; padding: 20rpx 0; border-bottom: 1rpx solid var(--color-border); }
.ex-row:last-child { border-bottom: none; }
.ex-row-icon { font-size: 40rpx; margin-right: 16rpx; }
.ex-row-info { flex: 1; }
.ex-row-name { display: block; font-size: 28rpx; }
.ex-row-meta { display: block; font-size: 22rpx; margin-top: 4rpx; }
.ex-row-kcal { font-weight: 600; color: var(--color-primary); margin: 0 16rpx; font-size: 27rpx; }
.del { color: var(--color-text-3); font-size: 26rpx; padding: 10rpx; }
.empty { display: flex; flex-direction: column; align-items: center; padding: 48rpx 0; gap: 16rpx; font-size: 24rpx; }
.empty-icon { font-size: 64rpx; }
.tip { text-align: center; font-size: 22rpx; color: var(--color-text-3); padding: 20rpx 0 40rpx; }
