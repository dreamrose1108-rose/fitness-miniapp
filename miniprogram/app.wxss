/* app.wxss — 全局样式 */
page {
  --color-primary: #2e7d5b;
  --color-primary-light: #e8f3ed;
  --color-danger: #b43d35;
  --color-warning: #92591c;
  --color-text: #1f2329;
  --color-text-2: #646a73;
  --color-text-3: #9aa0a6;
  --color-bg: #f5f6f8;
  --color-card: #ffffff;
  --color-border: #eceef1;
  --radius: 16rpx;
  --shadow: 0 4rpx 20rpx rgba(31, 35, 41, 0.05);

  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  color: var(--color-text);
  background: var(--color-bg);
  box-sizing: border-box;
}

view, text, input, textarea, button, image {
  box-sizing: border-box;
}

.page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: 40rpx;
}

.card {
  background: var(--color-card);
  border-radius: var(--radius);
  box-shadow: var(--shadow);
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--color-text);
  margin-bottom: 20rpx;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.flex-center {
  display: flex;
  align-items: center;
  justify-content: center;
}

.text-2 { color: var(--color-text-2); }
.text-3 { color: var(--color-text-3); }

.btn-primary {
  background: var(--color-primary);
  color: #fff;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 18rpx 0;
  text-align: center;
  border: none;
}
.btn-primary::after { border: none; }
.btn-primary[disabled] { opacity: 0.5; }

.safe-bottom {
  padding-bottom: constant(safe-area-inset-bottom);
  padding-bottom: env(safe-area-inset-bottom);
}

/* 骨架屏 */
.skeleton-item {
  background: linear-gradient(90deg, #f0f1f3 25%, #e6e8eb 37%, #f0f1f3 63%);
  background-size: 400% 100%;
  animation: skeleton-loading 1.4s ease infinite;
  border-radius: 12rpx;
}
@keyframes skeleton-loading {
  0% { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

/* Keep placeholder and unavailable-action labels readable in both palettes. */
.input-placeholder { color: var(--color-text-2); opacity: 1; }
button[disabled] {
  color: var(--color-text) !important;
  background: var(--color-border) !important;
  opacity: 1 !important;
}
